  "views": [
    {
      "entity": "mag_financialreviewrequest",
      "name": "My Open Reviews",
      "description": "Review requests I own that are not yet completed - the reviewer's Step 1 work queue.",
      "columns": [
        "mag_name",
        "mag_supplierid",
        "mag_gsaprecheckresult",
        "mag_reviewpath",
        "mag_reviewstatus",
        "mag_buyername",
        "createdon"
      ],
      "sort": [
        {
          "attr": "createdon",
          "dir": "desc"
        }
      ],
      "filters": [
        {
          "attr": "ownerid",
          "op": "eq-userid"
        },
        {
          "attr": "mag_reviewstatus",
          "op": "ne",
          "value": "Completed"
        }
      ]
    },
    {
      "entity": "mag_financialreviewrequest",
      "name": "New Requests - Not Started",
      "description": "Submitted requests still at status Not Started: full review needed after the GSA pre-check (source slide 3).",
