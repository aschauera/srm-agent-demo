      "sort": [
        {
          "attr": "createdon",
          "dir": "asc"
        }
      ],
      "filters": [
        {
          "attr": "mag_reviewstatus",
          "op": "eq",
          "value": "Not Started"
        }
      ]
    },
    {
      "entity": "mag_financialreviewrequest",
      "name": "Auto-Closed (GSA Reuse)",
