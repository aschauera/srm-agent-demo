      ],
      "filters": [
        {
          "attr": "mag_reviewpath",
          "op": "eq",
          "value": "GSA Reuse"
        }
      ]
    },
    {
      "entity": "mag_financialreviewrequest",
      "name": "Full Review Required",
      "description": "Open requests where GSA reuse criteria were not met (no match, expired, mandatory re-review, or no DUNS).",
